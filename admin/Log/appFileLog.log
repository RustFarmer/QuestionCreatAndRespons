    display: grid;
    gap: 16px;
}

.two-card-value {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
}

.two-card-value-percent {
    padding: 12px 14px;
    border-radius: 12px;
    background: rgba(79, 140, 255, 0.1);
    border: 1px solid rgba(79, 140, 255, 0.26);
}

