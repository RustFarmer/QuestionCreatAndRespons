    flex-direction: column;
    gap: 8px;
    margin-bottom: 14px;
}

.actions-panel {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
}

.counter-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 12px;
    border-radius: 999px;
    color: #dffcf5;
    font-weight: 800;
    background: rgba(49, 208, 170, 0.1);
    border: 1px solid rgba(49, 208, 170, 0.26);
}

.two-card {
    display: grid;
    gap: 16px;
}

.two-card-value {
    display: grid;
