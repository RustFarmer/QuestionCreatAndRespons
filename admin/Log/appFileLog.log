    color: var(--accent);
}

.list-blanc-question {
    display: flex;
    align-items: stretch;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
    width: min(1180px, 100%);
    margin: 0 auto 22px;
}

.list-blanc-question .OpenBlancQuestion,
