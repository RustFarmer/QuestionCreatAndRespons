}

* { box-sizing: border-box; }
html { min-height: 100%; }

body {
    margin: 0;
    min-height: 100vh;
    padding: 0 18px 48px;
    font-family: "Courier New", "Consolas", monospace;
    font-size: 15px;
    color: var(--text);
    background:
        radial-gradient(circle at 20% 30%, rgba(255, 46, 166, 0.18), transparent 40%),
        radial-gradient(circle at 80% 70%, rgba(0, 240, 255, 0.15), transparent 40%),
        linear-gradient(180deg, var(--bg), var(--bg-2));
    background-attachment: fixed;
    letter-spacing: 0.02em;
}

body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    background-image:
        linear-gradient(rgba(0, 240, 255, 0.06) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 46, 166, 0.06) 1px, transparent 1px);
    background-size: 40px 40px;
    z-index: -1;
}

.header {
    position: sticky;
    top: 14px;
    z-index: 20;
    display: flex; align-items: center;
    gap: 10px; flex-wrap: wrap;
    max-width: 1240px;
    margin: 14px auto 24px;
    padding: 12px 16px;
    background: rgba(10, 3, 32, 0.9);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft), inset 0 0 30px rgba(255, 46, 166, 0.06);
    backdrop-filter: blur(12px);
}
.header > div { display: flex; align-items: center; gap: 8px; }
.header h1 { margin: 0; font-size: 18px; text-transform: uppercase; letter-spacing: 0.15em; }
.header a { color: var(--text); text-decoration: none; transition: color 0.2s, text-shadow 0.2s; }
.header a:hover { color: var(--neon-cyan); text-shadow: 0 0 12px var(--neon-cyan); }
.header a i { margin-right: 6px; }
.header-text {
    display: inline-block;
    padding: 8px 14px;
    border-radius: var(--radius-sm);
    color: var(--neon-pink);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    background: rgba(255, 46, 166, 0.08);
    border: 1px solid var(--neon-pink);
    box-shadow: 0 0 18px rgba(255, 46, 166, 0.45), inset 0 0 18px rgba(255, 46, 166, 0.15);
    text-shadow: 0 0 8px var(--neon-pink);
}
.header-badge {
    min-width: 26px; height: 26px; padding: 0 8px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: var(--radius-sm); font-size: 12px; font-weight: 700;
    color: #05010f; background: var(--neon-yellow);
    box-shadow: 0 0 14px var(--neon-yellow);
}

.main-card,
.main-card-create-question,
.card,
.two-card,
.settings-card {
    width: min(1180px, 100%);
    margin: 0 auto 22px;
    padding: 22px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft), inset 0 0 30px rgba(255, 46, 166, 0.04);
    backdrop-filter: blur(10px);
}
.main-card h2,
.main-card-create-question h2,
.card h2,
.two-card h1 {
    margin: 0 0 16px;
    font-size: clamp(16px, 1.8vw, 22px);
    color: var(--neon-cyan);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-shadow: 0 0 10px var(--neon-cyan);
}
.question-card { background: transparent; border: 0; box-shadow: none; padding: 0; }

.question_cards-main {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
    width: min(1180px, 100%);
    margin: 0 auto;
}
.question_cards {
    display: flex; flex-direction: column; gap: 10px;
    padding: 18px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    backdrop-filter: blur(10px);
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
}
.question_cards:hover {
    transform: translateY(-3px);
    border-color: var(--neon-cyan);
    box-shadow: 0 0 30px rgba(0, 240, 255, 0.4);
}
.question_card_name,
.question_cards_topic,
.question_card_uername {
    padding: 9px 12px;
    border-radius: var(--radius-sm);
    font-size: 14px;
    color: var(--muted);
    background: rgba(255, 46, 166, 0.05);
    border: 1px solid rgba(255, 46, 166, 0.22);
    word-break: break-word;
}
.question_card_name {
    color: var(--text); font-size: 16px; font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-shadow: 0 0 8px var(--neon-pink);
}
.question_card_download_button,
.question_card_open_question_list {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px;
    border-radius: var(--radius-sm);
    background: rgba(0, 240, 255, 0.06);
    border: 1px solid var(--neon-cyan);
    box-shadow: 0 0 12px rgba(0, 240, 255, 0.3);
    transition: transform 0.2s, box-shadow 0.2s;
}
.question_card_download_button:hover,
.question_card_open_question_list:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 22px rgba(0, 240, 255, 0.6);
}
.question_card_download_button a,
.question_card_open_question_list a {
    color: var(--neon-cyan);
    font-size: 18px;
    text-decoration: none;
    text-shadow: 0 0 8px var(--neon-cyan);
}

.no-items {
    margin: 18px 0; padding: 18px;
    color: var(--muted); text-align: center;
    background: rgba(255, 46, 166, 0.04);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 12px;
}
.error-message {
    padding: 12px 14px; border-radius: var(--radius-sm);
    color: var(--neon-red);
    background: rgba(255, 56, 96, 0.08);
    border: 1px solid var(--neon-red);
    box-shadow: 0 0 15px rgba(255, 56, 96, 0.35);
}

.settings-card { display: grid; gap: 12px; }
.settings {
    position: relative;
    display: flex; align-items: center; justify-content: space-between;
    gap: 16px;
    padding: 16px 18px;
    background: rgba(0, 240, 255, 0.04);
    border: 1px solid rgba(0, 240, 255, 0.22);
    border-radius: var(--radius-sm);
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
}
.settings::after {
    content: ""; position: absolute;
    inset: 0 auto 0 0; width: 4px;
    background: linear-gradient(180deg, var(--neon-pink), var(--neon-cyan));
    box-shadow: 0 0 14px var(--neon-pink);
}
.settings:hover {
    transform: translateX(3px);
    box-shadow: 0 0 20px rgba(0, 240, 255, 0.3);
}
.settings-name h1 {
    margin: 0; font-size: 16px; font-weight: 700;
    word-break: break-word;
    letter-spacing: 0.06em;
}

.question {
    position: relative;
    margin-bottom: 18px;
    padding: 18px;
    background: rgba(20, 6, 50, 0.72);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-soft);
    backdrop-filter: blur(10px);
}
.question::after {
    content: ""; position: absolute;
    left: 18px; right: 18px; bottom: 0; height: 1px;
    background: linear-gradient(90deg, transparent, var(--neon-pink), var(--neon-cyan), transparent);
    box-shadow: 0 0 8px var(--neon-pink);
}
.question:hover { border-color: var(--neon-pink); box-shadow: 0 0 26px rgba(255, 46, 166, 0.3); }
.question-name h2, .question h2 {
    margin: 0 0 12px;
    font-size: clamp(15px, 1.6vw, 19px);
    color: var(--neon-cyan);
    text-shadow: 0 0 8px var(--neon-cyan);
    letter-spacing: 0.06em;
}

.question-answer {
    position: relative;
    margin: 8px 0;
    padding: 12px 14px 12px 38px;
    color: var(--text);
    background: rgba(255, 46, 166, 0.04);
    border: 1px solid rgba(255, 46, 166, 0.25);
    border-radius: var(--radius-sm);
    transition: background 0.2s, box-shadow 0.2s;
}
.question-answer::before {
    content: ""; position: absolute;
    left: 15px; top: 18px;
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--neon-pink);
    box-shadow: 0 0 12px var(--neon-pink);
}
.question-answer:hover {
    background: rgba(255, 46, 166, 0.1);
    box-shadow: 0 0 18px rgba(255, 46, 166, 0.3);
}
.question-answer:hover::before { background: var(--neon-cyan); box-shadow: 0 0 14px var(--neon-cyan); }
.question-answer h3 { margin: 0; font-size: 14px; font-weight: 500; word-break: break-word; letter-spacing: 0.04em; }
.question-answer.question-answer-true {
    background: rgba(57, 255, 20, 0.05);
    border-color: var(--neon-green);
    box-shadow: 0 0 14px rgba(57, 255, 20, 0.2);
}
.question-answer.question-answer-true::before {
    background: var(--neon-green);
    box-shadow: 0 0 12px var(--neon-green);
}
.question-answer.question-answer-true::after {
    content: "OK"; position: absolute;
    top: 10px; right: 12px;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    font-size: 10px; font-weight: 700;
    color: #05010f; background: var(--neon-green);
    box-shadow: 0 0 14px var(--neon-green);
    letter-spacing: 0.15em;
}

.del_question { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 12px; }
.change-question,
.btn_del_qst,
.share_question_card,
.use-button,
.download-button,
.deleteButtonList {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--neon-cyan);
    background: rgba(0, 240, 255, 0.06);
    box-shadow: 0 0 12px rgba(0, 240, 255, 0.22);
    transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
}
.change-question:hover,
.btn_del_qst:hover,
.share_question_card:hover,
.use-button:hover,
.download-button:hover,
.deleteButtonList:hover {
    transform: translateY(-2px);
    background: rgba(0, 240, 255, 0.14);
    box-shadow: 0 0 22px rgba(0, 240, 255, 0.55);
}
.change-question a,
.btn_del_qst a,
.share_question_card,
.use-button a,
.download-emoji a,
.deleteButtonList a {
    color: var(--neon-cyan);
    font-size: 12px; font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-shadow: 0 0 8px var(--neon-cyan);
}
.change-question h2 { margin: 0; font-size: 12px; font-weight: 700; letter-spacing: 0.12em; }
.btn_del_qst { border-color: var(--neon-red); background: rgba(255, 56, 96, 0.06); box-shadow: 0 0 12px rgba(255, 56, 96, 0.22); }
.btn_del_qst a { color: var(--neon-red); text-shadow: 0 0 8px var(--neon-red); }
.btn_del_qst:hover { background: rgba(255, 56, 96, 0.14); box-shadow: 0 0 22px rgba(255, 56, 96, 0.55); }
.share_question { margin-bottom: 8px; }
.share_question_card { cursor: pointer; color: var(--neon-cyan); font: inherit; }
.share_question_card button { border: 0; background: transparent; color: inherit; font: inherit; cursor: pointer; }

.download_question { position: relative; }
.download_question button,
.toggle-upload-btn {
    cursor: pointer;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--neon-yellow);
    color: var(--neon-yellow);
    background: rgba(255, 230, 0, 0.05);
    box-shadow: 0 0 14px rgba(255, 230, 0, 0.3);
    font: inherit; font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 12px;
    transition: transform 0.2s, box-shadow 0.2s;
}
.download_question button:hover,
.toggle-upload-btn:hover { transform: translateY(-1px); box-shadow: 0 0 24px rgba(255, 230, 0, 0.6); }

.upload-form-container {
    display: none;
    position: absolute;
    top: calc(100% + 10px); right: 0; z-index: 40;
    width: min(360px, 86vw);
    padding: 14px;
    background: var(--card-solid);
    border: 1px solid var(--neon-cyan);
    border-radius: var(--radius-sm);
    box-shadow: 0 0 30px rgba(0, 240, 255, 0.4);
}
.upload-form-container form { display: flex; flex-direction: column; gap: 10px; }
.upload-form-container textarea,
.upload-form-container input {
    width: 100%; min-height: 88px; resize: vertical;
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(0, 240, 255, 0.35);
    color: var(--text);
    background: rgba(5, 1, 15, 0.6);
    font: inherit; outline: none;
}
.upload-form-container textarea:focus,
.upload-form-container input:focus {
    border-color: var(--neon-cyan);
    box-shadow: 0 0 14px rgba(0, 240, 255, 0.5);
}
.upload-form-container button {
    align-self: flex-start;
    padding: 9px 14px;
    border-radius: var(--radius-sm);
    border: 0;
    color: #05010f;
    background: var(--neon-cyan);
    box-shadow: 0 0 14px rgba(0, 240, 255, 0.6);
    font: inherit; font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
}

.create-question-button a,
.change-image-result,
.update-card,
.clear-btn,
.pass-cut-off,
.OpenBlancQuestion {
    display: inline-flex; align-items: center; justify-content: center;
    gap: 8px;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    color: var(--neon-cyan);
    font-weight: 700;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border: 1px solid var(--neon-cyan);
    background: rgba(0, 240, 255, 0.05);
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 0 10px rgba(0, 240, 255, 0.2);
}
.create-question-button a:hover,
.change-image-result-card:hover .change-image-result,
.update-card:hover,
.clear-btn:hover,
.pass-cut-off:hover,
.OpenBlancQuestion:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 24px rgba(0, 240, 255, 0.55);
}
.create-question-button a {
    border-color: var(--neon-pink);
    color: var(--neon-pink);
    background: rgba(255, 46, 166, 0.05);
    box-shadow: 0 0 12px rgba(255, 46, 166, 0.3);
}
.create-question-button a:hover { box-shadow: 0 0 24px rgba(255, 46, 166, 0.6); }
.update-card a, .change-image-result a { color: inherit; text-decoration: none; }
.update-card i, .change-image-result i { color: inherit; }

.list-blanc-question {
    display: flex;
    align-items: stretch;
    justify-content: center;
    gap: 14px; flex-wrap: wrap;
    width: min(1180px, 100%);
    margin: 0 auto 22px;
}
.list-blanc-question .OpenBlancQuestion,
.list-blanc-question .pass-cut-off { flex: 1 1 260px; min-height: 64px; padding: 18px; }
.list-blanc-question h1,
.OpenBlancQuestion h1,
.pass-cut-off h1 {
    margin: 0;
    font-size: clamp(13px, 1.5vw, 17px);
    text-align: center;
    color: var(--neon-cyan);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-shadow: 0 0 8px var(--neon-cyan);
}

.input-text { display: flex; flex-direction: column; gap: 12px; }
.input-text label,
.answers-block label,
.question-name label,
.percent-text label,
.set-password label {
    color: var(--neon-cyan);
    font-size: 12px; font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
}
.input-text input[type="text"],
.input-text textarea,
.set-password input[type="text"],
.percent-text input[type="text"],
.answer-row input[type="text"],
.answer-row-true input[type="text"] {
    width: 100%;
    padding: 11px 14px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(0, 240, 255, 0.35);
    color: var(--text);
    background: rgba(5, 1, 15, 0.6);
    font: inherit; outline: none;
    letter-spacing: 0.04em;
    transition: border-color 0.2s, box-shadow 0.2s;
}
.input-text input[type="text"]:hover,
.input-text textarea:hover,
.percent-text input[type="text"]:hover,
.answer-row input[type="text"]:hover,
.answer-row-true input[type="text"]:hover {
    border-color: var(--neon-cyan);
    box-shadow: 0 0 12px rgba(0, 240, 255, 0.35);
}
.input-text input[type="text"]:focus,
.input-text textarea:focus,
.set-password input[type="text"]:focus,
.percent-text input[type="text"]:focus,
.answer-row input[type="text"]:focus,
.answer-row-true input[type="text"]:focus {
    border-color: var(--neon-cyan);
    box-shadow: 0 0 20px rgba(0, 240, 255, 0.55), inset 0 0 12px rgba(0, 240, 255, 0.15);
}

.answers-block {
    margin-top: 18px;
    padding: 16px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: rgba(255, 46, 166, 0.04);
}
.answers-container { display: grid; gap: 10px; }
.answer-row,
.answer-row-true {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    gap: 10px;
    padding: 12px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(255, 46, 166, 0.28);
    background: rgba(5, 1, 15, 0.45);
}
.answer-row-true {
    border-color: var(--neon-green);
    background: rgba(57, 255, 20, 0.04);
    box-shadow: 0 0 14px rgba(57, 255, 20, 0.15);
}
.answer-fields { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
.answer-row-true input[type="text"]:focus {
    border-color: var(--neon-green);
    box-shadow: 0 0 18px rgba(57, 255, 20, 0.45);
}

.answer-image-wrapper, .upload-block {
    display: flex; flex-direction: column; align-items: flex-start; gap: 8px;
}
.upload-block input[type="file"],
.answer-image-wrapper input[type="file"],
.file-upload-wrapper input[type="file"] {
    width: 100%;
    padding: 10px;
    border-radius: var(--radius-sm);
    border: 1px dashed rgba(0, 240, 255, 0.5);
    color: var(--muted);
    background: rgba(5, 1, 15, 0.5);
    font: inherit; cursor: pointer;
}
.upload-block input[type="file"]::file-selector-button,
.answer-image-wrapper input[type="file"]::file-selector-button {
    margin-right: 10px;
    padding: 8px 12px;
    border: 0;
    border-radius: var(--radius-sm);
    color: #05010f;
    background: var(--neon-cyan);
    box-shadow: 0 0 10px rgba(0, 240, 255, 0.5);
    font: inherit; font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 11px;
    cursor: pointer;
}
.upload-block img,
.answer-preview,
#image-preview,
.current-answer-image img {
    max-width: 100%;
    border-radius: var(--radius-sm);
    border: 1px solid var(--neon-cyan);
    box-shadow: 0 0 12px rgba(0, 240, 255, 0.3);
}

button.btn-small, .btn-small {
    display: inline-flex; align-items: center; justify-content: center;
    gap: 6px; width: auto;
    padding: 9px 13px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--neon-cyan);
    color: var(--neon-cyan);
    background: rgba(0, 240, 255, 0.05);
    box-shadow: 0 0 10px rgba(0, 240, 255, 0.22);
    font: inherit; font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
}
button.btn-small:hover, .btn-small:hover {
    transform: translateY(-1px);
    box-shadow: 0 0 22px rgba(0, 240, 255, 0.55);
}
.btn-add-answer {
    margin-top: 12px;
    border-color: var(--neon-green);
    color: var(--neon-green);
    background: rgba(57, 255, 20, 0.05);
    box-shadow: 0 0 10px rgba(57, 255, 20, 0.22);
}
.btn-add-answer:hover { box-shadow: 0 0 22px rgba(57, 255, 20, 0.55); }
.btn-remove-answer {
    border-color: var(--neon-red);
    color: var(--neon-red);
    background: rgba(255, 56, 96, 0.05);
    box-shadow: 0 0 10px rgba(255, 56, 96, 0.22);
}
.btn-remove-answer:hover { box-shadow: 0 0 22px rgba(255, 56, 96, 0.55); }

.btn-save,
.btn-submit,
.btn-add,
.btn-remove,
.btn-cancel,
.btn {
    display: inline-flex; align-items: center; justify-content: center;
    gap: 8px;
    padding: 11px 16px;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    font: inherit; font-weight: 700;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    cursor: pointer;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
}
.btn-save, .btn-submit, .btn-add {
    color: #05010f;
    background: var(--neon-cyan);
    box-shadow: 0 0 20px rgba(0, 240, 255, 0.55);
}
.btn-save:hover, .btn-submit:hover, .btn-add:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 32px rgba(0, 240, 255, 0.85);
}
.btn-cancel {
    color: var(--neon-pink);
    background: rgba(255, 46, 166, 0.05);
    border-color: var(--neon-pink);
    box-shadow: 0 0 12px rgba(255, 46, 166, 0.25);
}
.btn-cancel:hover {
    transform: translateY(-1px);
    box-shadow: 0 0 22px rgba(255, 46, 166, 0.55);
}
.btn-remove {
    color: var(--neon-red);
    background: rgba(255, 56, 96, 0.05);
    border-color: var(--neon-red);
    box-shadow: 0 0 12px rgba(255, 56, 96, 0.22);
}
.btn-remove:hover { box-shadow: 0 0 22px rgba(255, 56, 96, 0.55); }
.btn-remove:disabled, .btn-remove:disabled:hover { opacity: 0.4; cursor: not-allowed; transform: none; box-shadow: none; }
.btn-submit:disabled { opacity: 0.5; cursor: wait; }

.forms-container { display: grid; gap: 14px; }
.form-item {
    position: relative;
    padding: 18px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: rgba(255, 46, 166, 0.04);
}
.form-item:hover { border-color: var(--neon-cyan); box-shadow: 0 0 22px rgba(0, 240, 255, 0.3); }

.remove-single-btn, .two-remove-single-btn {
    position: absolute;
    top: 10px; right: 10px;
    display: inline-flex; align-items: center; justify-content: center;
    width: 34px; height: 34px;
    border-radius: 50%;
    border: 1px solid var(--neon-red);
    color: var(--neon-red);
    background: rgba(255, 56, 96, 0.08);
    box-shadow: 0 0 12px rgba(255, 56, 96, 0.3);
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
}
.remove-single-btn:hover, .two-remove-single-btn:hover {
    transform: rotate(90deg);
    box-shadow: 0 0 22px rgba(255, 56, 96, 0.6);
}
.percent-text { display: flex; flex-direction: column; gap: 8px; margin-bottom: 14px; }

.actions-panel {
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    margin-top: 16px; padding-top: 16px;
    border-top: 1px solid var(--border);
}
.counter-badge {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    color: var(--neon-yellow);
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: rgba(255, 230, 0, 0.05);
    border: 1px solid var(--neon-yellow);
    box-shadow: 0 0 12px rgba(255, 230, 0, 0.3);
}

.two-card { display: grid; gap: 16px; }
.two-card-value {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
}
.two-card-value-percent {
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    background: rgba(0, 240, 255, 0.06);
    border: 1px solid rgba(0, 240, 255, 0.3);
    box-shadow: 0 0 12px rgba(0, 240, 255, 0.15);
}
.two-card-value-percent h3 { margin: 0; font-size: 15px; color: var(--neon-cyan); text-shadow: 0 0 8px var(--neon-cyan); }
.image-preview-box {
    width: 100%; max-height: 260px;
    object-fit: contain;
    border-radius: var(--radius-sm);
    border: 1px solid var(--neon-cyan);
    background: rgba(5, 1, 15, 0.5);
    box-shadow: 0 0 12px rgba(0, 240, 255, 0.25);
}
.two-remove-single-btn {
    position: static;
    width: auto; height: auto;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    font: inherit; font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
}

.clear-btn { margin-left: auto; }
.clear-btn a { color: var(--neon-red); text-decoration: none; }
.clear-btn:hover { border-color: var(--neon-red); box-shadow: 0 0 22px rgba(255, 56, 96, 0.55); }

.question-list {
    display: flex; align-items: center; justify-content: space-between;
    gap: 14px; flex-wrap: wrap;
    margin-bottom: 12px;
    padding: 14px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: rgba(255, 46, 166, 0.04);
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
}
.question-list:hover {
    transform: translateY(-2px);
    border-color: var(--neon-cyan);
    box-shadow: 0 0 18px rgba(0, 240, 255, 0.3);
}
.question-list-name { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; width: 100%; }
.question-list-name h2 {
    margin: 0; flex: 1 1 240px;
    font-size: 15px; color: var(--text);
    letter-spacing: 0.06em;
}
.deleteButtonList {
    border-color: var(--neon-red);
    background: rgba(255, 56, 96, 0.05);
    box-shadow: 0 0 10px rgba(255, 56, 96, 0.22);
}
.deleteButtonList a { color: var(--neon-red); text-decoration: none; text-shadow: 0 0 8px var(--neon-red); }
.download-emoji {
    display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--neon-cyan);
    background: rgba(0, 240, 255, 0.06);
    box-shadow: 0 0 10px rgba(0, 240, 255, 0.25);
}
.download-emoji a { text-decoration: none; }

.preview-container {
    display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
    margin-bottom: 18px;
    padding: 16px;
    border-radius: var(--radius);
    border: 1px dashed var(--neon-cyan);
    background: rgba(0, 240, 255, 0.03);
}
.preview-box {
    display: flex; align-items: center; justify-content: center;
    width: 150px; height: 110px;
    overflow: hidden;
    border-radius: var(--radius-sm);
    color: var(--muted);
    background: rgba(5, 1, 15, 0.6);
    border: 1px solid rgba(0, 240, 255, 0.4);
}
.preview-box img { width: 100%; height: 100%; object-fit: cover; }
.preview-box.has-image { border-color: var(--neon-cyan); box-shadow: 0 0 20px rgba(0, 240, 255, 0.5); }
.preview-info { display: grid; gap: 4px; min-width: 0; }
.preview-info .file-name {
    max-width: 360px;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    color: var(--neon-cyan);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-shadow: 0 0 8px var(--neon-cyan);
}
.preview-info .file-size { color: var(--muted); font-size: 12px; letter-spacing: 0.08em; }

.file-upload-wrapper { position: relative; margin-bottom: 12px; }
.file-upload-wrapper input[type="file"] {
    position: absolute; inset: 0; opacity: 0; cursor: pointer; z-index: 2;
}
.file-upload-btn {
    display: flex; align-items: center; justify-content: center;
    gap: 10px;
    min-height: 88px; padding: 18px;
    border-radius: var(--radius);
    border: 1px dashed var(--neon-cyan);
    color: var(--muted);
    background: rgba(0, 240, 255, 0.03);
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 12px;
    transition: border-color 0.2s, background 0.2s, box-shadow 0.2s, color 0.2s;
}
.file-upload-btn i { color: var(--neon-cyan); font-size: 20px; }
.file-upload-btn:hover, .file-upload-btn.dragover {
    color: var(--neon-cyan);
    border-color: var(--neon-cyan);
    box-shadow: 0 0 24px rgba(0, 240, 255, 0.5);
    background: rgba(0, 240, 255, 0.08);
}
.file-upload-btn.has-file {
    border-style: solid;
    border-color: var(--neon-green);
    background: rgba(57, 255, 20, 0.05);
    box-shadow: 0 0 20px rgba(57, 255, 20, 0.4);
    color: var(--neon-green);
}

.image-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 12px;
    margin-top: 16px;
}
.image-card, .image-item {
    position: relative;
    display: grid; gap: 8px;
    padding: 12px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(0, 240, 255, 0.3);
    background: rgba(5, 1, 15, 0.5);
}
.image-item:hover { border-color: var(--neon-cyan); box-shadow: 0 0 16px rgba(0, 240, 255, 0.35); }
.image-item .file-name {
    color: var(--neon-cyan); font-size: 11px; font-weight: 700;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    letter-spacing: 0.08em;
}
.image-item .use-button { justify-self: start; }
.deleteFinallyImage { position: absolute; top: 8px; right: 8px; }
.deleteFinallyImage a { color: var(--neon-red); text-decoration: none; text-shadow: 0 0 8px var(--neon-red); }

.range-section { display: grid; gap: 8px; margin-top: 16px; }
.range-section .range-label {
    display: flex; align-items: center; gap: 8px;
    color: var(--neon-cyan); font-size: 12px; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.1em;
}
.range-section .range-label i { color: var(--neon-cyan); }
.range-wrapper { display: flex; align-items: center; gap: 12px; }
.range-wrapper input[type="range"] {
    width: 100%; height: 6px;
    appearance: none;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--neon-pink) 0%, var(--neon-pink) 50%, rgba(255, 46, 166, 0.15) 50%, rgba(255, 46, 166, 0.15) 100%);
    outline: none;
}
.range-wrapper input[type="range"]::-webkit-slider-thumb {
    appearance: none;
    width: 20px; height: 20px;
    border-radius: 50%;
    border: 2px solid #05010f;
    background: var(--neon-cyan);
    box-shadow: 0 0 16px var(--neon-cyan);
    cursor: pointer;
}
.range-wrapper input[type="range"]::-moz-range-thumb {
    width: 20px; height: 20px;
    border-radius: 50%;
    border: 2px solid #05010f;
    background: var(--neon-cyan);
    box-shadow: 0 0 16px var(--neon-cyan);
    cursor: pointer;
}
.range-value {
    min-width: 52px;
    padding: 6px 9px;
    border-radius: var(--radius-sm);
    color: var(--neon-cyan);
    font-size: 12px; font-weight: 700;
    text-align: center;
    background: rgba(0, 240, 255, 0.06);
    border: 1px solid var(--neon-cyan);
    box-shadow: 0 0 10px rgba(0, 240, 255, 0.3);
    letter-spacing: 0.08em;
}

.status-message {
    display: none;
    align-items: center; gap: 8px;
    margin-top: 12px;
    padding: 11px 13px;
    border-radius: var(--radius-sm);
    color: var(--muted);
    background: rgba(5, 1, 15, 0.5);
    border: 1px solid var(--border);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
}
.status-message.show { display: flex; }
.status-message.success {
    color: var(--neon-green);
    background: rgba(57, 255, 20, 0.05);
    border-color: var(--neon-green);
    box-shadow: 0 0 14px rgba(57, 255, 20, 0.35);
}
.status-message.error {
    color: var(--neon-red);
    background: rgba(255, 56, 96, 0.06);
    border-color: var(--neon-red);
    box-shadow: 0 0 14px rgba(255, 56, 96, 0.35);
}
.status-message i { color: currentColor; }

.set-password { display: grid; gap: 8px; }
.btn-save, .btn-cancel { margin-right: 8px; }

@media (max-width: 760px) {
    body { padding: 0 10px 32px; }
    .header { position: static; margin-top: 10px; padding: 10px; }
    .header h1 { font-size: 16px; }
    .main-card, .main-card-create-question, .card, .two-card, .settings-card { padding: 15px; }
    .list-blanc-question { flex-direction: column; }
    .list-blanc-question .OpenBlancQuestion, .list-blanc-question .pass-cut-off { width: 100%; flex: none; }
    .answer-row, .answer-row-true { grid-template-columns: 1fr; }
    .btn-remove-answer { justify-self: start; }
    .preview-container { flex-direction: column; align-items: flex-start; }
    .preview-box { width: 100%; height: 170px; }
    .actions-panel { flex-direction: column; align-items: stretch; }
    .actions-panel .btn { width: 100%; }
    .two-card-value { grid-template-columns: 1fr; }
    .clear-btn { margin-left: 0; width: 100%; }
    .clear-btn a { width: 100%; }
    .upload-form-container { position: static; width: 100%; margin-top: 10px; }
}

@media (max-width: 480px) {
    .header > div, .header .update-card, .header .download_question,
    .header .create-question-button, .header .change-image-result-card { width: 100%; }
    .header-text, .create-question-button a, .change-image-result,
    .update-card, .clear-btn, .pass-cut-off, .OpenBlancQuestion,
    .download_question button, .toggle-upload-btn { width: 100%; }
    .question_cards-main { grid-template-columns: 1fr; }
    .form-item, .answers-block, .question { padding: 12px; }
    .btn-save, .btn-cancel, .btn-submit, .btn-small { width: 100%; }
    .btn-save, .btn-cancel { margin-right: 0; }
}
