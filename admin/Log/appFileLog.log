* { box-sizing: border-box; }
html { min-height: 100%; }

body {
    margin: 0;
    min-height: 100vh;
    padding: 0 18px 48px;
    font-family: "Segoe UI", Inter, Arial, sans-serif;
    font-size: 15px;
    color: var(--text);
    background: var(--bg);
    background-image: linear-gradient(180deg, var(--bg-2), var(--bg));
    background-attachment: fixed;
}

.header {
    position: sticky;
    top: 14px;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    max-width: 1240px;
    margin: 14px auto 24px;
    padding: 12px 16px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow: var(--shadow);
}

.header > div { display: flex; align-items: center; gap: 8px; }
