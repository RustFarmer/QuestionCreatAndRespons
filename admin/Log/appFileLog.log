}

.create-question-button a,
.change-image-result-card a,
.update-card a,
.clear-btn a,
.pass-cut-off a,
.OpenBlancQuestion a {
    text-decoration: none;
}

.create-question-button a,
.change-image-result,
.update-card,
.clear-btn,
.pass-cut-off,
.OpenBlancQuestion {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 14px;
    border-radius: 13px;
    color: #ffffff;
    font-weight: 750;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.045);
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
}

.create-question-button a:hover,
.change-image-result-card:hover .change-image-result,
.update-card:hover,
.clear-btn:hover,
.pass-cut-off:hover,
