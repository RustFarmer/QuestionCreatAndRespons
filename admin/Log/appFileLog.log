    background: var(--card-soft);
}
.two-remove-single-btn {
    position: static;
    width: auto; height: auto;
    padding: 8px 12px;
    border-radius: 9px;
    font: inherit; font-weight: 600;
}

.clear-btn { margin-left: auto; }
.clear-btn a { color: var(--danger); text-decoration: none; }
.clear-btn:hover { border-color: var(--danger); color: var(--danger); }

.question-list {
    display: flex; align-items: center; justify-content: space-between;
    gap: 14px; flex-wrap: wrap;
    margin-bottom: 12px;
    padding: 14px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--card-soft);
    transition: transform 0.2s, border-color 0.2s;
}
.question-list:hover { transform: translateY(-2px); border-color: var(--accent); }
.question-list-name { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; width: 100%; }
.question-list-name h2 { margin: 0; flex: 1 1 240px; font-size: 17px; color: var(--text); }
.deleteButtonList {
    border-color: rgba(229, 56, 76, 0.24);
    background: rgba(229, 56, 76, 0.06);
}
.deleteButtonList a { color: var(--danger); text-decoration: none; }
.download-emoji {
    display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--card-soft);
}
.download-emoji a { text-decoration: none; }

.preview-container {
    display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
    margin-bottom: 18px;
    padding: 16px;
    border-radius: var(--radius);
    border: 1px dashed var(--border-strong);
    background: var(--card-soft);
}
.preview-box {
    display: flex; align-items: center; justify-content: center;
    width: 150px; height: 110px;
    overflow: hidden;
    border-radius: 12px;
    color: var(--muted);
    background: #fff;
    border: 1px solid var(--border);
}
.preview-box img { width: 100%; height: 100%; object-fit: cover; }
.preview-box.has-image { border-color: var(--accent); }
.preview-info { display: grid; gap: 4px; min-width: 0; }
.preview-info .file-name {
    max-width: 360px;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    color: var(--text); font-weight: 600;
}
.preview-info .file-size { color: var(--muted); font-size: 13px; }

.file-upload-wrapper { position: relative; margin-bottom: 12px; }
.file-upload-wrapper input[type="file"] {
    position: absolute; inset: 0; opacity: 0; cursor: pointer; z-index: 2;
}
.file-upload-btn {
    display: flex; align-items: center; justify-content: center;
    gap: 10px;
    min-height: 88px; padding: 18px;
    border-radius: var(--radius);
    border: 1px dashed var(--border-strong);
    color: var(--muted);
    background: var(--card-soft);
    text-align: center;
    transition: border-color 0.2s, background 0.2s, color 0.2s;
}
.file-upload-btn i { color: var(--accent); font-size: 20px; }
.file-upload-btn:hover, .file-upload-btn.dragover {
    color: var(--text);
    border-color: var(--accent);
    background: rgba(43, 108, 255, 0.06);
}
.file-upload-btn.has-file {
    border-style: solid;
    border-color: rgba(0, 180, 138, 0.4);
    background: rgba(0, 180, 138, 0.06);
}

.image-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 12px;
    margin-top: 16px;
}
.image-card, .image-item {
    position: relative;
    display: grid; gap: 8px;
    padding: 12px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--card-soft);
}
.image-item:hover { border-color: var(--accent); }
.image-item .file-name {
    color: var(--text); font-size: 13px; font-weight: 600;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.image-item .use-button { justify-self: start; }
.deleteFinallyImage { position: absolute; top: 8px; right: 8px; }
.deleteFinallyImage a { color: var(--danger); text-decoration: none; }

.range-section { display: grid; gap: 8px; margin-top: 16px; }
.range-section .range-label {
    display: flex; align-items: center; gap: 8px;
    color: var(--muted); font-size: 14px; font-weight: 600;
}
.range-section .range-label i { color: var(--accent); }
.range-wrapper { display: flex; align-items: center; gap: 12px; }
.range-wrapper input[type="range"] {
    width: 100%; height: 6px;
    appearance: none;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--accent) 0%, var(--accent) 50%, #e1e6ef 50%, #e1e6ef 100%);
    outline: none;
}
.range-wrapper input[type="range"]::-webkit-slider-thumb {
    appearance: none;
    width: 18px; height: 18px;
    border-radius: 50%;
    border: 3px solid #fff;
    background: var(--accent);
    box-shadow: 0 2px 8px rgba(43, 108, 255, 0.4);
    cursor: pointer;
}
.range-wrapper input[type="range"]::-moz-range-thumb {
    width: 18px; height: 18px;
    border-radius: 50%;
    border: 3px solid #fff;
    background: var(--accent);
    cursor: pointer;
}
.range-value {
    min-width: 52px;
    padding: 6px 9px;
    border-radius: 8px;
    color: var(--accent);
    font-size: 13px; font-weight: 700;
    text-align: center;
    background: rgba(43, 108, 255, 0.08);
    border: 1px solid rgba(43, 108, 255, 0.22);
}

.status-message {
    display: none;
    align-items: center; gap: 8px;
    margin-top: 12px;
    padding: 11px 13px;
    border-radius: 10px;
    color: var(--muted);
    background: var(--card-soft);
    border: 1px solid var(--border);
}
.status-message.show { display: flex; }
.status-message.success {
    color: var(--accent-2);
    background: rgba(0, 180, 138, 0.06);
    border-color: rgba(0, 180, 138, 0.28);
}
.status-message.error {
    color: var(--danger);
    background: rgba(229, 56, 76, 0.06);
    border-color: rgba(229, 56, 76, 0.28);
}
.status-message i { color: currentColor; }

.set-password { display: grid; gap: 8px; }
.btn-save, .btn-cancel { margin-right: 8px; }

@media (max-width: 760px) {
    body { padding: 0 10px 32px; }
    .header { position: static; margin-top: 10px; padding: 10px; }
    .header h1 { font-size: 17px; }
    .main-card, .main-card-create-question, .card, .two-card, .settings-card { padding: 15px; }
    .list-blanc-question { flex-direction: column; }
    .list-blanc-question .OpenBlancQuestion, .list-blanc-question .pass-cut-off { width: 100%; flex: none; }
    .answer-row, .answer-row-true { grid-template-columns: 1fr; }
    .btn-remove-answer { justify-self: start; }
    .preview-container { flex-direction: column; align-items: flex-start; }
    .preview-box { width: 100%; height: 170px; }
    .actions-panel { flex-direction: column; align-items: stretch; }
    .actions-panel .btn { width: 100%; }
    .two-card-value { grid-template-columns: 1fr; }
    .clear-btn { margin-left: 0; width: 100%; }
    .clear-btn a { width: 100%; }
    .upload-form-container { position: static; width: 100%; margin-top: 10px; }
}

@media (max-width: 480px) {
    .header > div, .header .update-card, .header .download_question,
    .header .create-question-button, .header .change-image-result-card { width: 100%; }
    .header-text, .create-question-button a, .change-image-result,
    .update-card, .clear-btn, .pass-cut-off, .OpenBlancQuestion,
    .download_question button, .toggle-upload-btn { width: 100%; }
    .question_cards-main { grid-template-columns: 1fr; }
    .form-item, .answers-block, .question { padding: 12px; }
    .btn-save, .btn-cancel, .btn-submit, .btn-small { width: 100%; }
    .btn-save, .btn-cancel { margin-right: 0; }
}
