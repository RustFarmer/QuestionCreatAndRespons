.btn-save:hover,
.btn-submit:hover,
.btn-add:hover {
    transform: translateY(-2px);
    filter: brightness(1.08);
}

.btn-cancel {
    color: #dce8ff;
    background: rgba(255, 255, 255, 0.055);
    border-color: var(--border);
}

.btn-cancel:hover {
    transform: translateY(-1px);
    background: rgba(255, 255, 255, 0.09);
}

.btn-remove {
    color: #ffd7df;
    background: rgba(255, 92, 122, 0.1);
    border-color: rgba(255, 92, 122, 0.3);
}

.btn-remove:hover {
    background: rgba(255, 92, 122, 0.18);
}

.btn-remove:disabled,
.btn-remove:disabled:hover {
    opacity: 0.45;
    cursor: not-allowed;
    transform: none;
}

.btn-submit:active,
.btn:active,
.btn-add:active,
.btn-remove:active {
    transform: translateY(0) scale(0.99);
}

.btn-submit:disabled {
    opacity: 0.6;
    cursor: wait;
}

.forms-container {
    display: grid;
    gap: 14px;
}

.form-item {
    position: relative;
    padding: 18px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.04);
}

.form-item:hover {
    border-color: rgba(79, 140, 255, 0.34);
}

.remove-single-btn,
.two-remove-single-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid rgba(255, 92, 122, 0.3);
    color: #ffd7df;
    background: rgba(255, 92, 122, 0.1);
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease;
}

.remove-single-btn:hover,
.two-remove-single-btn:hover {
    transform: rotate(90deg);
    background: rgba(255, 92, 122, 0.22);
}

.percent-text {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 14px;
}

.actions-panel {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
}

.counter-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 12px;
    border-radius: 999px;
    color: #dffcf5;
    font-weight: 800;
    background: rgba(49, 208, 170, 0.1);
    border: 1px solid rgba(49, 208, 170, 0.26);
}

.two-card {
    display: grid;
    gap: 16px;
}

.two-card-value {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
}

.two-card-value-percent {
    padding: 12px 14px;
    border-radius: 12px;
    background: rgba(79, 140, 255, 0.1);
    border: 1px solid rgba(79, 140, 255, 0.26);
}

.two-card-value-percent h3 {
    margin: 0;
    font-size: 16px;
}

.image-preview-box {
    width: 100%;
    max-height: 260px;
    object-fit: contain;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: rgba(0, 0, 0, 0.18);
}

.two-remove-single-btn {
    position: static;
    width: auto;
    height: auto;
    padding: 8px 12px;
    border-radius: 10px;
    font: inherit;
    font-weight: 700;
}

.clear-btn {
    margin-left: auto;
}

.clear-btn a {
    color: #ffd7df;
}

.clear-btn:hover {
    background: rgba(255, 92, 122, 0.14);
    border-color: rgba(255, 92, 122, 0.38);
}

.list-blanc-question .pass-cut-off {
    color: #ffffff;
}

.question-list {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 12px;
    padding: 14px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.04);
    transition: transform 0.2s ease, border-color 0.2s ease;
}

.question-list:hover {
    transform: translateY(-2px);
    border-color: rgba(79, 140, 255, 0.35);
}

.question-list-name {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    width: 100%;
}

.question-list-name h2 {
    margin: 0;
    flex: 1 1 240px;
    font-size: 17px;
}

.deleteList {
    order: 2;
}

.deleteButtonList {
    border-color: rgba(255, 92, 122, 0.28);
    background: rgba(255, 92, 122, 0.08);
}

.deleteButtonList a {
    color: #ffd7df;
}

.download-button {
    order: 3;
}

.download-emoji {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: rgba(79, 140, 255, 0.1);
}

.download-emoji a {
    text-decoration: none;
}

.preview-container {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 18px;
    padding: 16px;
    border-radius: var(--radius);
    border: 1px dashed rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.035);
}

.preview-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 150px;
    height: 110px;
    overflow: hidden;
    border-radius: 14px;
    color: var(--muted);
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid var(--border);
}

.preview-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.preview-box.has-image {
    border-color: rgba(79, 140, 255, 0.42);
}

.preview-info {
    display: grid;
    gap: 5px;
    min-width: 0;
}

.preview-info .file-name {
    max-width: 360px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: #ffffff;
    font-weight: 700;
}

.preview-info .file-size {
    color: var(--muted);
    font-size: 13px;
}

.file-upload-wrapper {
    position: relative;
    margin-bottom: 12px;
}

.file-upload-wrapper input[type="file"] {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
    z-index: 2;
}

.file-upload-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 88px;
    padding: 18px;
    border-radius: var(--radius);
    border: 1px dashed rgba(255, 255, 255, 0.24);
    color: var(--muted);
    background: rgba(255, 255, 255, 0.035);
    text-align: center;
    transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
}

.file-upload-btn i {
    color: var(--accent);
    font-size: 20px;
}

.file-upload-btn:hover,
.file-upload-btn.dragover {
    color: #ffffff;
    border-color: rgba(79, 140, 255, 0.65);
    background: rgba(79, 140, 255, 0.1);
}

.file-upload-btn.has-file {
    border-style: solid;
    border-color: rgba(49, 208, 170, 0.4);
    background: rgba(49, 208, 170, 0.07);
}

.image-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 12px;
    margin-top: 16px;
}

.image-card,
.image-item {
    position: relative;
    display: grid;
    gap: 8px;
    padding: 12px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.04);
}

.image-item:hover {
    border-color: rgba(79, 140, 255, 0.35);
}

.image-item .file-name {
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.image-item .use-button {
    justify-self: start;
}

.deleteFinallyImage {
    position: absolute;
    top: 8px;
    right: 8px;
}

.deleteFinallyImage a {
    color: #ffd7df;
    text-decoration: none;
}

.range-section {
    display: grid;
    gap: 8px;
    margin-top: 16px;
}

.range-section .range-label {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 650;
}

.range-section .range-label i {
    color: var(--accent);
}

.range-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
}

.range-wrapper input[type="range"] {
    width: 100%;
    height: 7px;
    appearance: none;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--accent) 0%, var(--accent) 50%, rgba(255, 255, 255, 0.09) 50%, rgba(255, 255, 255, 0.09) 100%);
    outline: none;
}

.range-wrapper input[type="range"]::-webkit-slider-thumb {
    appearance: none;
    width: 19px;
    height: 19px;
    border-radius: 50%;
    border: 3px solid #ffffff;
    background: var(--accent);
    box-shadow: 0 4px 12px rgba(79, 140, 255, 0.45);
    cursor: pointer;
}

.range-wrapper input[type="range"]::-moz-range-thumb {
    width: 19px;
    height: 19px;
    border-radius: 50%;
    border: 3px solid #ffffff;
    background: var(--accent);
    box-shadow: 0 4px 12px rgba(79, 140, 255, 0.45);
    cursor: pointer;
}

.range-value {
    min-width: 52px;
    padding: 6px 9px;
    border-radius: 9px;
    color: #dce8ff;
    font-size: 13px;
    font-weight: 800;
    text-align: center;
    background: rgba(79, 140, 255, 0.12);
    border: 1px solid rgba(79, 140, 255, 0.25);
}

.status-message {
    display: none;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    padding: 11px 13px;
    border-radius: 11px;
    color: var(--muted);
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid var(--border);
}

.status-message.show {
    display: flex;
}

.status-message.success {
    color: #dffcf5;
    background: rgba(49, 208, 170, 0.09);
    border-color: rgba(49, 208, 170, 0.28);
}

.status-message.error {
    color: #ffd7df;
    background: rgba(255, 92, 122, 0.09);
    border-color: rgba(255, 92, 122, 0.3);
}

.status-message i {
    color: currentColor;
}

.set-password {
    display: grid;
    gap: 8px;
}

.btn-save,
.btn-cancel {
    margin-right: 8px;
}

@media (max-width: 760px) {
    body {
        padding: 0 10px 32px;
    }

    .header {
        position: static;
        margin-top: 10px;
        padding: 10px;
        border-radius: 16px;
    }

    .header h1 {
        font-size: 17px;
    }

    .header-text {
        padding: 7px 9px;
    }

    .main-card,
    .main-card-create-question,
    .card,
    .two-card,
    .settings-card {
        padding: 15px;
        border-radius: 14px;
    }

    .list-blanc-question {
        flex-direction: column;
    }

    .list-blanc-question .OpenBlancQuestion,
    .list-blanc-question .pass-cut-off {
        width: 100%;
        flex: none;
    }

    .answer-row,
    .answer-row-true {
        grid-template-columns: 1fr;
    }

    .btn-remove-answer {
        justify-self: start;
    }

    .preview-container {
        align-items: flex-start;
        flex-direction: column;
    }

    .preview-box {
        width: 100%;
        height: 170px;
    }

    .actions-panel {
        flex-direction: column;
        align-items: stretch;
    }

    .actions-panel .btn {
        width: 100%;
    }

    .counter-badge {
        align-self: flex-start;
    }

    .two-card-value {
        grid-template-columns: 1fr;
    }

    .clear-btn {
        margin-left: 0;
        width: 100%;
    }

    .clear-btn a {
        width: 100%;
    }

    .question-list-name {
        align-items: flex-start;
    }

    .deleteList,
    .download-button {
        order: initial;
    }

    .upload-form-container {
        position: static;
        width: 100%;
        margin-top: 10px;
    }
}

@media (max-width: 480px) {
    .header {
        gap: 8px;
    }

    .header > div,
    .header .update-card,
    .header .download_question,
    .header .create-question-button,
    .header .change-image-result-card {
        width: 100%;
    }

    .header-text,
    .create-question-button a,
    .change-image-result,
    .update-card,
    .clear-btn,
    .pass-cut-off,
    .OpenBlancQuestion,
    .download_question button,
    .toggle-upload-btn {
        width: 100%;
    }

    .question_cards-main {
        grid-template-columns: 1fr;
    }

    .question_cards {
        padding: 14px;
    }

    .form-item,
    .answers-block,
    .question {
        padding: 12px;
    }

    .btn-save,
    .btn-cancel,
    .btn-submit,
    .btn-small {
        width: 100%;
    }

    .btn-save,
    .btn-cancel {
        margin-right: 0;
    }
}
