    margin: 0;
    font-size: 16px;
}

.image-preview-box {
    width: 100%;
    max-height: 260px;
    object-fit: contain;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: rgba(0, 0, 0, 0.18);
}

.two-remove-single-btn {
    position: static;
    width: auto;
    height: auto;
    padding: 8px 12px;
    border-radius: 10px;
    font: inherit;
    font-weight: 700;
}

.clear-btn {
    margin-left: auto;
}

.clear-btn a {
    color: #ffd7df;
}

.clear-btn:hover {
    background: rgba(255, 92, 122, 0.14);
    border-color: rgba(255, 92, 122, 0.38);
}

.list-blanc-question .pass-cut-off {
    color: #ffffff;
}

.question-list {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 12px;
    padding: 14px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.04);
    transition: transform 0.2s ease, border-color 0.2s ease;
}

.question-list:hover {
    transform: translateY(-2px);
    border-color: rgba(79, 140, 255, 0.35);
}

.question-list-name {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    width: 100%;
}

.question-list-name h2 {
    margin: 0;
    flex: 1 1 240px;
    font-size: 17px;
}

.deleteList {
    order: 2;
}

.deleteButtonList {
    border-color: rgba(255, 92, 122, 0.28);
    background: rgba(255, 92, 122, 0.08);
}

.deleteButtonList a {
    color: #ffd7df;
}

.download-button {
    order: 3;
}

.download-emoji {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: rgba(79, 140, 255, 0.1);
}

