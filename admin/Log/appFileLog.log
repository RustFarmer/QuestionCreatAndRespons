    text-decoration: none;
}

.preview-container {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 18px;
    padding: 16px;
    border-radius: var(--radius);
    border: 1px dashed rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.035);
}

.preview-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 150px;
    height: 110px;
    overflow: hidden;
    border-radius: 14px;
    color: var(--muted);
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid var(--border);
}

.preview-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.preview-box.has-image {
    border-color: rgba(79, 140, 255, 0.42);
}

.preview-info {
    display: grid;
    gap: 5px;
    min-width: 0;
}

.preview-info .file-name {
    max-width: 360px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: #ffffff;
    font-weight: 700;
}

