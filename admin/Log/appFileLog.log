    display: inline-block;
    padding: 8px 12px;
    border-radius: 10px;
    font-weight: 700;
    color: var(--accent);
    background: rgba(43, 108, 255, 0.08);
    border: 1px solid rgba(43, 108, 255, 0.2);
}
.header-badge {
    min-width: 26px; height: 26px; padding: 0 8px;
